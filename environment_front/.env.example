# OneNET Studio 配置
# 在 OneNET 控制台获取:
#   - 用户 ID:      控制台右上角头像 -> 用户中心 -> 用户ID
#   - access_key:   产品详情页 -> 访问控制 -> 产品级 access_key
#   - 产品 ID:      产品详情页 -> 产品ID
#   - 默认设备名:   设备管理 -> 设备详情 -> DeviceName
ONENET_USER_ID=
ONENET_ACCESS_KEY=
ONENET_PRODUCT_ID=
ONENET_DEVICE_NAME=

# 后端服务端口（前端代理目标）
SERVER_PORT=3001
